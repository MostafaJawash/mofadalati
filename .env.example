# PostgreSQL connection string (Supabase, Neon, RDS or local Postgres).
# Supabase: Project Settings > Database > Connection string (use the pooler URL
# on serverless hosts) and append ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:54329/mofadalati

# Set to true to force TLS (automatically on when the URL has sslmode=require).
DATABASE_SSL=false

# Password for the /admin panel. Required.
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string
